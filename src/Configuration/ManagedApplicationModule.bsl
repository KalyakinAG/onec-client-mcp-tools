#Область ОбработчикиСобытий

&После("ПриНачалеРаботыСистемы")
Процедура mcp_1c_ПриНачалеРаботыСистемыОткрытьФорму()

	Если СтрНайти(ВРег(ПараметрЗапуска), "RUNMCP") = 0 Тогда
		Возврат;
	КонецЕсли;

	// Порядок &После-хуков расширений не определён: гарантируем инициализацию
	// реестров MCP до открытия формы. Повторный вызов безопасен — на этот момент
	// инструменты ещё не регистрировались, провайдеры восстанавливаются сами.
	Сервер = mcp_1c_МодульМспСервер();
	Если Сервер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Сервер.Инициализировать();
	Исключение
		Возврат; // инициализация реестров не удалась — форму не открываем
	КонецПопытки;

	ОткрытьФорму("Обработка.client_mcp_tools.Форма", , , "mcp_1c_enterprise_автостарт");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция mcp_1c_МодульМспСервер()
	Попытка
		Возврат Вычислить("Мсп_Сервер");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

#КонецОбласти
