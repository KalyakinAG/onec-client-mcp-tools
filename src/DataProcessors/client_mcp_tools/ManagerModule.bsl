#Область СлужебныеПроцедурыИФункции

// Выполняет код в фоновом задании длительной операции БСП (ДлительныеОперации.ВыполнитьФункцию).
//
// Код выполняется методом Выполнить; переменная "Результат" объявлена заранее и
// доступна коду. По конвенции код устанавливает переменную "Результат" - её значение
// возвращается (если не установлена - null). Возвращаемое значение сериализуется
// в строку JSON - сериализуемый тип, требование ДлительныеОперации.
//
// Параметры:
//   Код - Строка - Код на встроенном языке 1С (последовательность операторов).
//   ВыражениеРезультата - Строка - Выражение, результат вычисления которого возвращается.
//
// Возвращаемое значение:
//   Строка - JSON вида type - тип результата, value - значение.
Функция ВыполнитьКодВФоне(Знач Код, Знач ВыражениеРезультата) Экспорт

	// Объявлена заранее: код из Выполнить и Вычислить(ВыражениеРезультата)
	// используют её динамически, статический контроль её не видит.
	Перем Результат;
	Результат = Неопределено;

	Выполнить(Код);

	Возврат СериализоватьРезультатВычисленияMCP(Вычислить(ВыражениеРезультата));

КонецФункции

// Сериализует результат вычисления в строку JSON вида type/value.
// Та же схема, что у синхронного execute_code формы обработки.
//
// Параметры:
//   Результат - Произвольный - Результат вычисления выражения.
//
// Возвращаемое значение:
//   Строка - JSON вида type - тип результата, value - значение.
Функция СериализоватьРезультатВычисленияMCP(Результат)

	ТипРезультата = ТипЗнч(Результат);

	Обёртка = Новый Структура;
	Обёртка.Вставить("type", Строка(ТипРезультата));

	Если ТипРезультата = Тип("Число")
		Или ТипРезультата = Тип("Булево")
		Или ТипРезультата = Тип("Строка")
		Или ТипРезультата = Тип("Неопределено") Тогда
		Обёртка.Вставить("value", Результат);
	ИначеЕсли ТипРезультата = Тип("Дата") Тогда
		ЗначениеДаты = "";
		Если Результат > Дата(1, 1, 1) Тогда
			ЗначениеДаты = Формат(Результат, "ДФ=гггг-ММ-дд") + "T" + Формат(Результат, "ДФ=ЧЧ:мм:сс");
		КонецЕсли;
		Обёртка.Вставить("value", ЗначениеДаты);
	Иначе
		Обёртка.Вставить("value", Строка(Результат));
	КонецЕсли;

	Возврат ЗаписатьЗначениеJSON(Обёртка);

КонецФункции

#КонецОбласти
