#Область ОписаниеПеременных

// Реестр запущенных фоновых операций (ДлительныеОперации БСП):
// УИД задания (строка) -> адрес результата во временном хранилище.
// Живёт в сеансе формы; операция удаляется при выдаче результата.
&НаКлиенте
Перем ОперацииMCP;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОперацииMCP = Новый Соответствие;
	ЗарегистрироватьИнструментMCP();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	ОтменитьРегистрациюMCP();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РегистрацияИнструмента

&НаКлиенте
Процедура ЗарегистрироватьИнструментMCP()

	Сервер = МодульМспСервер();
	Если Сервер = Неопределено Тогда
		СообщитьПользователюMCP("Инструменты MCP не зарегистрированы: расширение client_mcp (модуль Мсп_Сервер) недоступно в этой базе.");
		Возврат;
	КонецЕсли;

	Схема = МодульМспСхемаПараметров();
	Если Схема = Неопределено Тогда
		СообщитьПользователюMCP("Инструменты MCP не зарегистрированы: модуль Мсп_СхемаПараметров недоступен.");
		Возврат;
	КонецЕсли;

	ЗарегистрироватьИнструментEvaluateExpressionMCP(Сервер, Схема);
	ЗарегистрироватьИнструментExecuteCodeMCP(Сервер, Схема);
	ЗарегистрироватьИнструментExecuteQueryMCP(Сервер, Схема);
	ЗарегистрироватьИнструментStartCodeExecutionMCP(Сервер, Схема);
	ЗарегистрироватьИнструментПолучитьСтатусMCP(Сервер, Схема);
	ЗарегистрироватьИнструментПолучитьРезультатMCP(Сервер, Схема);

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРегистрациюMCP()
	Сервер = МодульМспСервер();
	Если Сервер <> Неопределено Тогда
		Сервер.ОтменитьРегистрацию(ИмяПровайдера());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ИмяПровайдера()
	Возврат "mcp-1c-enterprise";
КонецФункции

&НаКлиенте
Функция МодульМспСервер()
	Попытка
		Возврат Вычислить("Мсп_Сервер");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция МодульМспСхемаПараметров()
	Попытка
		Возврат Вычислить("Мсп_СхемаПараметров");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ОшибкаИнструментаMCP(КодОшибки, ТекстОшибки)
	Возврат МодульМспСервер().ОшибкаИнструмента(КодОшибки, ТекстОшибки);
КонецФункции

&НаКлиенте
Процедура СообщитьПользователюMCP(ТекстСообщения)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
КонецПроцедуры

#КонецОбласти

#Область ИнструментEvaluateExpression

&НаКлиенте
Процедура ЗарегистрироватьИнструментEvaluateExpressionMCP(Сервер, Схема)

	Свойства = Новый Структура;
	Свойства.Вставить("expression", Схема.НовыйСвойствоСхемы("string",
		"Выражение на встроенном языке 1С. Вычисляется методом Вычислить в контексте формы обработки."));
	Свойства.Вставить("on_client", Схема.НовыйСвойствоСхемы("boolean",
		"Если true - выражение вычисляется в клиентском контексте; по умолчанию false - в серверном контексте (&НаСервере формы)."));
	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("expression");
	СхемаПараметров = Схема.НовыйСхемаОбъекта(Свойства, ОбязательныеПоля);

	Инструмент = Сервер.НовыйИнструмент(
		"evaluate_expression",
		"Вычисляет выражение на встроенном языке 1С методом Вычислить. "
			+ "Параметры: expression (обязательный) - текст выражения; on_client - если true, вычисление выполняется в клиентском контексте, иначе в серверном (по умолчанию). "
			+ "Возвращает JSON {""type"", ""value""}: тип результата и его значение (нативные JSON-типы там, где возможно). "
			+ "Внимание: инструмент исполняет произвольный код 1С в сеансе, где открыта обработка.",
		СхемаПараметров,
		Новый ОписаниеОповещения("ВычислитьВыражение", ЭтотОбъект));

	Сервер.ЗарегистрироватьИнструмент(Инструмент, ИмяПровайдера());

КонецПроцедуры

// Вычисляет выражение на встроенном языке 1С (инструмент MCP evaluate_expression).
//
// Параметры:
//   Запрос - Структура - Запрос вызова инструмента:
//     * Аргументы - Структура - Аргументы вызова (expression, on_client).
//     * Контекст - Структура - Контекст вызова.
//   ДополнительныеПараметры - Произвольный - Не используется.
//
// Возвращаемое значение:
//   Строка - JSON вида {"type": <тип результата>, "value": <значение>}.
//   Структура - Ошибка инструмента (КодОшибки, Ошибка).
&НаКлиенте
Функция ВычислитьВыражение(Запрос, ДополнительныеПараметры) Экспорт

	Выражение = ЗначениеПараметраЗапроса(Запрос, "expression");
	Если ТипЗнч(Выражение) <> Тип("Строка") Или ПустаяСтрока(Выражение) Тогда
		Возврат ОшибкаИнструментаMCP("INVALID_PARAMS",
			"Параметр 'expression' обязателен и должен быть непустой строкой.");
	КонецЕсли;

	Если ЗначениеПараметраЗапроса(Запрос, "on_client") = Истина Тогда
		Попытка
			Результат = Вычислить(Выражение);
		Исключение
			Возврат ОшибкаИнструментаMCP("ACTION_FAILED",
				"Ошибка вычисления на клиенте: " + ТекстОшибкиMCP(ИнформацияОбОшибке()));
		КонецПопытки;
	Иначе
		Попытка
			Результат = ВычислитьНаСервереMCP(Выражение);
		Исключение
			Возврат ОшибкаИнструментаMCP("ACTION_FAILED",
				"Ошибка вычисления на сервере: " + ТекстОшибкиMCP(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Возврат СериализоватьРезультатMCP(Результат);

КонецФункции

// Вычисляет выражение в серверном контексте формы обработки.
//
// Параметры:
//   Выражение - Строка - Текст выражения на встроенном языке 1С.
//
// Возвращаемое значение:
//   Произвольный - Результат вычисления выражения.
//
// Исключения:
//   Текст ошибки вычисления.
&НаСервере
Функция ВычислитьНаСервереMCP(Выражение)
	Попытка
		Возврат Вычислить(Выражение);
	Исключение
		ВызватьИсключение "Ошибка вычисления выражения на сервере: " + ТекстОшибкиMCP(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область ИнструментExecuteCode

&НаКлиенте
Процедура ЗарегистрироватьИнструментExecuteCodeMCP(Сервер, Схема)

	Свойства = Новый Структура;
	Свойства.Вставить("code", Схема.НовыйСвойствоСхемы("string",
		"Код на встроенном языке 1С (последовательность операторов). Выполняется методом Выполнить; по конвенции устанавливает переменную ""Результат""."));
	Свойства.Вставить("on_client", Схема.НовыйСвойствоСхемы("boolean",
		"Если true - код выполняется в клиентском контексте; по умолчанию false - в серверном контексте (&НаСервере формы)."));
	Свойства.Вставить("returnExpression", Схема.НовыйСвойствоСхемы("string",
		"Выражение, результат вычисления которого будет возвращен; вычисляется в контексте выполнения кода. По умолчанию ""Результат""."));
	СхемаПараметров = Схема.НовыйСхемаОбъекта(Свойства);

	Инструмент = Сервер.НовыйИнструмент(
		"execute_code",
		"Выполняет код на встроенном языке 1С методом Выполнить. "
			+ "Параметры: code (обязательный) - код для выполнения; on_client - если true, код выполняется в клиентском контексте, иначе в серверном (по умолчанию); "
			+ "returnExpression - выражение, результат вычисления которого будет возвращен (по умолчанию ""Результат""). "
			+ "Возвращает JSON {""type"", ""value""}: тип результата и его значение (нативные JSON-типы там, где возможно). "
			+ "Внимание: инструмент исполняет произвольный код 1С в сеансе, где открыта обработка.",
		СхемаПараметров,
		Новый ОписаниеОповещения("ВыполнитьКод", ЭтотОбъект));

	Сервер.ЗарегистрироватьИнструмент(Инструмент, ИмяПровайдера());

КонецПроцедуры

// Выполняет код на встроенном языке 1С (инструмент MCP execute_code).
//
// Код выполняется методом Выполнить в контексте обработчика; переменная "Результат"
// объявлена заранее и доступна коду. По конвенции код устанавливает переменную
// "Результат" - её значение возвращается (если не установлена - Неопределено).
//
// Параметры:
//   Запрос - Структура - Запрос вызова инструмента:
//     * Аргументы - Структура - Аргументы вызова (code, on_client, returnExpression).
//     * Контекст - Структура - Контекст вызова.
//   ДополнительныеПараметры - Произвольный - Не используется.
//
// Возвращаемое значение:
//   Строка - JSON вида {"type": <тип результата>, "value": <значение>}.
//   Структура - Ошибка инструмента (КодОшибки, Ошибка).
&НаКлиенте
Функция ВыполнитьКод(Запрос, ДополнительныеПараметры) Экспорт

	// Объявлена заранее: код из Выполнить и Вычислить(returnExpression)
	// используют её динамически, статический контроль её не видит.
	Перем Результат;
	Результат = Неопределено;

	Код = ЗначениеПараметраЗапроса(Запрос, "code");
	Если ТипЗнч(Код) <> Тип("Строка") Или ПустаяСтрока(Код) Тогда
		Возврат ОшибкаИнструментаMCP("INVALID_PARAMS",
			"Параметр 'code' обязателен и должен быть непустой строкой.");
	КонецЕсли;

	ВыражениеРезультата = ЗначениеПараметраЗапроса(Запрос, "returnExpression");
	Если ТипЗнч(ВыражениеРезультата) <> Тип("Строка") Или ПустаяСтрока(ВыражениеРезультата) Тогда
		ВыражениеРезультата = "Результат";
	КонецЕсли;

	Если ЗначениеПараметраЗапроса(Запрос, "on_client") = Истина Тогда
		Попытка
			Выполнить(Код);
			РезультатВычисления = Вычислить(ВыражениеРезультата);
		Исключение
			Возврат ОшибкаИнструментаMCP("ACTION_FAILED",
				"Ошибка выполнения кода на клиенте: " + ТекстОшибкиMCP(ИнформацияОбОшибке()));
		КонецПопытки;
	Иначе
		Попытка
			РезультатВычисления = ВыполнитьКодНаСервереMCP(Код, ВыражениеРезультата);
		Исключение
			Возврат ОшибкаИнструментаMCP("ACTION_FAILED",
				"Ошибка выполнения кода на сервере: " + ТекстОшибкиMCP(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

	Возврат СериализоватьРезультатMCP(РезультатВычисления);

КонецФункции

// Выполняет код и вычисляет выражение результата в серверном контексте формы обработки.
//
// Параметры:
//   Код - Строка - Код на встроенном языке 1С (последовательность операторов).
//   ВыражениеРезультата - Строка - Выражение, результат вычисления которого возвращается.
//
// Возвращаемое значение:
//   Произвольный - Результат вычисления выражения.
//
// Исключения:
//   Текст ошибки выполнения кода или вычисления выражения.
&НаСервере
Функция ВыполнитьКодНаСервереMCP(Код, ВыражениеРезультата)
	// Объявлена заранее: код из Выполнить и Вычислить(ВыражениеРезультата)
	// используют её динамически, статический контроль её не видит.
	Перем Результат;
	Результат = Неопределено;
	Попытка
		Выполнить(Код);
		Возврат Вычислить(ВыражениеРезультата);
	Исключение
		ВызватьИсключение "Ошибка выполнения кода на сервере: " + ТекстОшибкиMCP(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область ИнструментExecuteQuery

&НаКлиенте
Процедура ЗарегистрироватьИнструментExecuteQueryMCP(Сервер, Схема)

	Свойства = Новый Структура;
	Свойства.Вставить("query", Схема.НовыйСвойствоСхемы("string",
		"Текст запроса на языке запросов 1С для чтения данных. Обязательный."));
	Свойства.Вставить("parameters", Схема.НовыйСвойствоСхемы("object",
		"Параметры &Имя: имя -> значение. Строки ГГГГ-ММ-ДД или ГГГГ-ММ-ДДTчч:мм:сс преобразуются в дату; массивы передаются как есть."));
	Свойства.Вставить("limit", Схема.НовыйСвойствоСхемы("integer",
		"Максимум строк: по умолчанию 100, не более 1000."));
	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("query");
	СхемаПараметров = Схема.НовыйСхемаОбъекта(Свойства, ОбязательныеПоля);

	Инструмент = Сервер.НовыйИнструмент(
		"execute_query",
		"Выполняет запрос на языке запросов 1С и возвращает результат в JSON: колонки, строки и признак продолжения. "
			+ "Параметры: query (обязательный) - текст запроса; parameters - объект параметров &Имя (ISO-строки дат преобразуются в дату); limit - максимум строк (по умолчанию 100, не более 1000). "
			+ "Возвращает JSON {Таблица, Колонки, Строки, КоличествоСтрок, Лимит, ЕстьЕщё}: ссылки в Строки приходят строками-представлениями. "
			+ "Запрос выполняется на сервере; только чтение данных.",
		СхемаПараметров,
		Новый ОписаниеОповещения("ВыполнитьЗапросMCP", ЭтотОбъект));

	Сервер.ЗарегистрироватьИнструмент(Инструмент, ИмяПровайдера());

КонецПроцедуры

// Выполняет запрос на языке запросов 1С (инструмент MCP execute_query).
//
// Параметры:
//   Запрос - Структура - Запрос вызова инструмента:
//     * Аргументы - Структура - Аргументы вызова (query, parameters, limit).
//     * Контекст - Структура - Контекст вызова.
//   ДополнительныеПараметры - Произвольный - Не используется.
//
// Возвращаемое значение:
//   Строка - JSON {Таблица, Колонки, Строки, КоличествоСтрок, Лимит, ЕстьЕщё}.
//   Структура - Ошибка инструмента (КодОшибки, Ошибка).
&НаКлиенте
Функция ВыполнитьЗапросMCP(Запрос, ДополнительныеПараметры) Экспорт

	ТекстЗапроса = ЗначениеПараметраЗапроса(Запрос, "query");
	Если ТипЗнч(ТекстЗапроса) <> Тип("Строка") Или ПустаяСтрока(ТекстЗапроса) Тогда
		Возврат ОшибкаИнструментаMCP("INVALID_PARAMS",
			"Параметр 'query' обязателен и должен быть непустой строкой.");
	КонецЕсли;

	ПараметрыЗапроса = ЗначениеПараметраЗапроса(Запрос, "parameters");
	Если ПараметрыЗапроса <> Неопределено
		И ТипЗнч(ПараметрыЗапроса) <> Тип("Структура")
		И ТипЗнч(ПараметрыЗапроса) <> Тип("Соответствие") Тогда
		Возврат ОшибкаИнструментаMCP("INVALID_PARAMS",
			"Параметр 'parameters' должен быть объектом имя -> значение.");
	КонецЕсли;

	Лимит = ЗначениеПараметраЗапроса(Запрос, "limit");
	Если Лимит <> Неопределено И ТипЗнч(Лимит) <> Тип("Число") Тогда
		Возврат ОшибкаИнструментаMCP("INVALID_PARAMS",
			"Параметр 'limit' должен быть числом.");
	КонецЕсли;

	Попытка
		Данные = ВыполнитьЗапросНаСервереMCP(ТекстЗапроса, ПараметрыЗапроса, Лимит);
		Возврат СериализоватьJSONMCP(Данные);
	Исключение
		Возврат ОшибкаИнструментаMCP("ACTION_FAILED",
			"Ошибка выполнения запроса: " + ТекстОшибкиMCP(ИнформацияОбОшибке()));
	КонецПопытки;

КонецФункции

// Выполняет запрос и собирает результат в серверном контексте формы обработки.
//
// Параметры:
//   ТекстЗапроса - Строка - Текст запроса на языке запросов 1С.
//   ПараметрыЗапроса - Произвольный - Параметры запроса &Имя (Структура или Соответствие), Неопределено - параметры отсутствуют.
//   Лимит - Число, Неопределено - Максимум строк выборки.
//
// Возвращаемое значение:
//   Структура - Результат запроса с именем таблицы, колонками, строками,
//     количеством строк, применённым лимитом и признаком наличия строк сверх лимита.
//
// Исключения:
//   Текст ошибки выполнения запроса.
&НаСервере
Функция ВыполнитьЗапросНаСервереMCP(ТекстЗапроса, ПараметрыЗапроса, Лимит)

	НормализованныйЛимит = НормализованныйЛимитMCP(Лимит);

	Запрос = Новый Запрос(ТекстЗапроса);
	Если ТипЗнч(ПараметрыЗапроса) = Тип("Структура") Тогда
		Для Каждого Параметр Из ПараметрыЗапроса Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, ЗначениеДляПараметраЗапросаMCP(Параметр.Значение));
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПараметрыЗапроса) = Тип("Соответствие") Тогда
		Для Каждого Параметр Из ПараметрыЗапроса Цикл
			Запрос.УстановитьПараметр(Строка(Параметр.Ключ), ЗначениеДляПараметраЗапросаMCP(Параметр.Значение));
		КонецЦикла;
	КонецЕсли;

	РезультатЗапроса = Запрос.Выполнить();

	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		Колонки.Добавить(Новый Структура("Имя, Тип", Колонка.Имя, Строка(Колонка.ТипЗначения)));
	КонецЦикла;

	Строки = Новый Массив;
	ЕстьЕщё = Ложь;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Строки.Количество() >= НормализованныйЛимит Тогда
			ЕстьЕщё = Истина;
			Прервать;
		КонецЕсли;
		ЗначенияСтроки = Новый Соответствие;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			ЗначенияСтроки.Вставить(Колонка.Имя, ЗначениеРезультатаЗапросаMCP(Выборка[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(ЗначенияСтроки);
	КонецЦикла;

	Данные = Новый Структура;
	Данные.Вставить("Таблица", "");
	Данные.Вставить("Колонки", Колонки);
	Данные.Вставить("Строки", Строки);
	Данные.Вставить("КоличествоСтрок", Строки.Количество());
	Данные.Вставить("Лимит", НормализованныйЛимит);
	Данные.Вставить("ЕстьЕщё", ЕстьЕщё);
	Возврат Данные;

КонецФункции

#КонецОбласти

#Область ИнструментыАсинхронногоВыполнения

// Асинхронное выполнение кода через БСП ДлительныеОперации (polling-модель).
// Запуск и выполнение - только в серверном контексте (параметр on_client не используется):
// длительная операция БСП исполняет экспортную функцию модуля менеджера обработки
// Обработка.client_mcp_tools.ВыполнитьКодВФоне в фоновом задании.
// Реестр операций ОперацииMCP хранит адрес результата во временном хранилище;
// результат выдаётся инструментом get_execution_result один раз, запись удаляется.

&НаКлиенте
Процедура ЗарегистрироватьИнструментStartCodeExecutionMCP(Сервер, Схема)

	Свойства = Новый Структура;
	Свойства.Вставить("code", Схема.НовыйСвойствоСхемы("string",
		"Код на встроенном языке 1С (последовательность операторов). Выполняется методом Выполнить в фоновом задании; по конвенции устанавливает переменную ""Результат"". Обязательный."));
	Свойства.Вставить("returnExpression", Схема.НовыйСвойствоСхемы("string",
		"Выражение, результат вычисления которого будет возвращен; вычисляется в контексте выполнения кода. По умолчанию ""Результат""."));
	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("code");
	СхемаПараметров = Схема.НовыйСхемаОбъекта(Свойства, ОбязательныеПоля);

	Инструмент = Сервер.НовыйИнструмент(
		"start_code_execution",
		"Ставит выполнение кода на встроенном языке 1С в очередь фоновых заданий БСП (ДлительныеОперации) и возвращает operation_id немедленно. "
			+ "Параметры: code (обязательный) - код для выполнения; returnExpression - выражение результата (по умолчанию ""Результат""). "
			+ "Только серверное исполнение (параметр on_client не используется). "
			+ "Статус и результат возвращают get_execution_status и get_execution_result; результат выдаётся один раз. "
			+ "Внимание: инструмент исполняет произвольный код 1С в сеансе, где открыта обработка.",
		СхемаПараметров,
		Новый ОписаниеОповещения("НачатьВыполнениеКодаMCP", ЭтотОбъект));

	Сервер.ЗарегистрироватьИнструмент(Инструмент, ИмяПровайдера());

КонецПроцедуры

// Ставит код в очередь фоновых заданий БСП (инструмент MCP start_code_execution).
//
// Параметры:
//   Запрос - Структура - Запрос вызова инструмента:
//     * Аргументы - Структура - Аргументы вызова (code, returnExpression).
//     * Контекст - Структура - Контекст вызова.
//   ДополнительныеПараметры - Произвольный - Не используется.
//
// Возвращаемое значение:
//   Строка - JSON с идентификатором запущенной операции.
//   Структура - Ошибка инструмента (КодОшибки, Ошибка).
&НаКлиенте
Функция НачатьВыполнениеКодаMCP(Запрос, ДополнительныеПараметры) Экспорт

	Код = ЗначениеПараметраЗапроса(Запрос, "code");
	Если ТипЗнч(Код) <> Тип("Строка") Или ПустаяСтрока(Код) Тогда
		Возврат ОшибкаИнструментаMCP("INVALID_PARAMS",
			"Параметр 'code' обязателен и должен быть непустой строкой.");
	КонецЕсли;

	ВыражениеРезультата = ЗначениеПараметраЗапроса(Запрос, "returnExpression");
	Если ТипЗнч(ВыражениеРезультата) <> Тип("Строка") Или ПустаяСтрока(ВыражениеРезультата) Тогда
		ВыражениеРезультата = "Результат";
	КонецЕсли;

	Попытка
		Запуск = ЗапуститьВыполнениеКодаВФонеMCP(Код, ВыражениеРезультата);
	Исключение
		Возврат ОшибкаИнструментаMCP("ACTION_FAILED",
			"Ошибка запуска фоновой операции: " + ТекстОшибкиMCP(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Запуск.ТекстОшибки <> "" Тогда
		Возврат ОшибкаИнструментаMCP("ACTION_FAILED",
			"Фоновая операция не запущена: " + Запуск.ТекстОшибки);
	КонецЕсли;

	ОперацииMCP.Вставить(Запуск.ИдентификаторЗадания, Запуск.АдресРезультата);

	Возврат СериализоватьJSONMCP(Новый Структура("operation_id", Запуск.ИдентификаторЗадания));

КонецФункции

// Запускает фоновое задание БСП и собирает параметры запуска в серверном контексте формы.
//
// Параметры:
//   Код - Строка - Код на встроенном языке 1С.
//   ВыражениеРезультата - Строка - Выражение результата вычисления.
//
// Возвращаемое значение:
//   Структура - ИдентификаторЗадания (строка), АдресРезультата (строка), ТекстОшибки (строка).
//
// Исключения:
//   Текст ошибки запуска фонового задания.
&НаСервере
Функция ЗапуститьВыполнениеКодаВФонеMCP(Код, ВыражениеРезультата)

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗадания", "");
	Результат.Вставить("АдресРезультата", "");
	Результат.Вставить("ТекстОшибки", "");

	ИдентификаторОперации = Новый УникальныйИдентификатор;
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(ИдентификаторОперации);
	Запуск = ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Обработки.client_mcp_tools.ВыполнитьКодВФоне", Код, ВыражениеРезультата);

	Если Запуск.Статус = "Ошибка" Тогда
		Если Запуск.ИнформацияОбОшибке <> Неопределено Тогда
			Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(Запуск.ИнформацияОбОшибке);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;

	Если Запуск.ИдентификаторЗадания = Неопределено Тогда
		Результат.ТекстОшибки = "Фоновое задание не запущено, статус: " + Запуск.Статус;
		Возврат Результат;
	КонецЕсли;

	Результат.ИдентификаторЗадания = Строка(Запуск.ИдентификаторЗадания);
	Результат.АдресРезультата = Запуск.АдресРезультата;
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ЗарегистрироватьИнструментПолучитьСтатусMCP(Сервер, Схема)

	Свойства = Новый Структура;
	Свойства.Вставить("operation_id", Схема.НовыйСвойствоСхемы("string",
		"Идентификатор операции, возвращенный start_code_execution."));
	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("operation_id");
	СхемаПараметров = Схема.НовыйСхемаОбъекта(Свойства, ОбязательныеПоля);

	Инструмент = Сервер.НовыйИнструмент(
		"get_execution_status",
		"Возвращает статус фонового задания: pending до получения результата, затем done или error. "
			+ "Параметр: operation_id (обязательный) - идентификатор операции из start_code_execution.",
		СхемаПараметров,
		Новый ОписаниеОповещения("ПолучитьСтатусОперацииMCP", ЭтотОбъект));

	Сервер.ЗарегистрироватьИнструмент(Инструмент, ИмяПровайдера());

КонецПроцедуры

// Возвращает статус фонового задания (инструмент MCP get_execution_status).
//
// Параметры:
//   Запрос - Структура - Запрос вызова инструмента:
//     * Аргументы - Структура - Аргументы вызова (operation_id).
//     * Контекст - Структура - Контекст вызова.
//   ДополнительныеПараметры - Произвольный - Не используется.
//
// Возвращаемое значение:
//   Строка - JSON с идентификатором и статусом операции (pending/done/error).
//   Структура - Ошибка инструмента (КодОшибки, Ошибка).
&НаКлиенте
Функция ПолучитьСтатусОперацииMCP(Запрос, ДополнительныеПараметры) Экспорт

	Идентификатор = ИдентификаторОперацииMCP(Запрос);
	Если Идентификатор = "" Тогда
		Возврат ОшибкаИнструментаMCP("INVALID_PARAMS",
			"Параметр 'operation_id' обязателен и должен быть строкой УИД.");
	КонецЕсли;

	Если ОперацииMCP.Получить(Идентификатор) = Неопределено Тогда
		Возврат ОшибкаИнструментаMCP("ACTION_FAILED", "Операция не найдена: " + Идентификатор);
	КонецЕсли;

	Попытка
		Состояние = СостояниеОперацииНаСервереMCP(Идентификатор);
	Исключение
		Возврат ОшибкаИнструментаMCP("ACTION_FAILED",
			"Ошибка опроса состояния операции: " + ТекстОшибкиMCP(ИнформацияОбОшибке()));
	КонецПопытки;

	Ответ = Новый Структура;
	Ответ.Вставить("operation_id", Идентификатор);
	Ответ.Вставить("status", Состояние.СтатусМСП);
	Если Состояние.ТекстОшибки <> "" Тогда
		Ответ.Вставить("error", Состояние.ТекстОшибки);
	КонецЕсли;

	Возврат СериализоватьJSONMCP(Ответ);

КонецФункции

// Опрашивает состояние фонового задания через ДлительныеОперации в серверном контексте формы.
// Маппинг статусов БСП: Выполняется -> pending, Выполнено -> done, иное -> error.
//
// Параметры:
//   Идентификатор - Строка - Строковое представление УИД фонового задания.
//
// Возвращаемое значение:
//   Структура - СтатусМСП (pending/done/error), ТекстОшибки (строка).
&НаСервере
Функция СостояниеОперацииНаСервереMCP(Идентификатор)

	Результат = Новый Структура;
	Результат.Вставить("СтатусМСП", "error");
	Результат.Вставить("ТекстОшибки", "");

	ИдентификаторОперации = Новый УникальныйИдентификатор(Идентификатор);

	// ЗаданиеВыполнено бросает исключение при аварийном завершении фонового задания -
	// разворачиваем его в статус error с текстом ошибки, а не в ошибку вызова инструмента.
	Попытка
		Состояние = ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторОперации, Ложь);
	Исключение
		Результат.СтатусМСП = "error";
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Если Состояние.Статус = "Выполняется" Тогда
		Результат.СтатусМСП = "pending";
	ИначеЕсли Состояние.Статус = "Выполнено" Тогда
		Результат.СтатусМСП = "done";
	Иначе
		Если Состояние.ИнформацияОбОшибке <> Неопределено Тогда
			Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(Состояние.ИнформацияОбОшибке);
		ИначеЕсли Состояние.Свойство("ТекстОшибки") Тогда
			Результат.ТекстОшибки = Состояние.ТекстОшибки;
		КонецЕсли;
		Результат.СтатусМСП = "error";
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ЗарегистрироватьИнструментПолучитьРезультатMCP(Сервер, Схема)

	Свойства = Новый Структура;
	Свойства.Вставить("operation_id", Схема.НовыйСвойствоСхемы("string",
		"Идентификатор операции, возвращенный start_code_execution."));
	ОбязательныеПоля = Новый Массив;
	ОбязательныеПоля.Добавить("operation_id");
	СхемаПараметров = Схема.НовыйСхемаОбъекта(Свойства, ОбязательныеПоля);

	Инструмент = Сервер.НовыйИнструмент(
		"get_execution_result",
		"Возвращает результат фонового задания, когда оно завершилось; до завершения возвращает статус pending. "
			+ "Параметр: operation_id (обязательный). Результат - JSON вида type/value, как у execute_code. "
			+ "Результат выдаётся один раз, затем операция удаляется из сеанса; для ошибки возвращает ошибку с её текстом.",
		СхемаПараметров,
		Новый ОписаниеОповещения("ПолучитьРезультатОперацииMCP", ЭтотОбъект));

	Сервер.ЗарегистрироватьИнструмент(Инструмент, ИмяПровайдера());

КонецПроцедуры

// Возвращает результат фонового задания (инструмент MCP get_execution_result).
// Завершённая операция (done/error) выдаёт результат один раз и удаляется из реестра.
//
// Параметры:
//   Запрос - Структура - Запрос вызова инструмента:
//     * Аргументы - Структура - Аргументы вызова (operation_id).
//     * Контекст - Структура - Контекст вызова.
//   ДополнительныеПараметры - Произвольный - Не используется.
//
// Возвращаемое значение:
//   Строка - JSON результата или JSON со статусом pending.
//   Структура - Ошибка инструмента (КодОшибки, Ошибка).
&НаКлиенте
Функция ПолучитьРезультатОперацииMCP(Запрос, ДополнительныеПараметры) Экспорт

	Идентификатор = ИдентификаторОперацииMCP(Запрос);
	Если Идентификатор = "" Тогда
		Возврат ОшибкаИнструментаMCP("INVALID_PARAMS",
			"Параметр 'operation_id' обязателен и должен быть строкой УИД.");
	КонецЕсли;

	АдресРезультата = ОперацииMCP.Получить(Идентификатор);
	Если АдресРезультата = Неопределено Тогда
		Возврат ОшибкаИнструментаMCP("ACTION_FAILED", "Операция не найдена: " + Идентификатор);
	КонецЕсли;

	Попытка
		Состояние = СостояниеОперацииНаСервереMCP(Идентификатор);
	Исключение
		Возврат ОшибкаИнструментаMCP("ACTION_FAILED",
			"Ошибка опроса состояния операции: " + ТекстОшибкиMCP(ИнформацияОбОшибке()));
	КонецПопытки;

	Если Состояние.СтатусМСП = "pending" Тогда
		Возврат СериализоватьJSONMCP(Новый Структура("operation_id, status", Идентификатор, "pending"));
	КонецЕсли;

	Если Состояние.СтатусМСП = "done" Тогда
		Попытка
			Результат = ПолучитьРезультатНаСервереMCP(АдресРезультата);
		Исключение
			Состояние.СтатусМСП = "error";
			Состояние.ТекстОшибки = ТекстОшибкиMCP(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЕсли;

	ОперацииMCP.Удалить(Идентификатор);

	Если Состояние.СтатусМСП = "error" Тогда
		ТекстОшибки = Состояние.ТекстОшибки;
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = "Ошибка выполнения фонового задания.";
		КонецЕсли;
		Возврат ОшибкаИнструментаMCP("ACTION_FAILED", ТекстОшибки);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Читает результат из временного хранилища в серверном контексте формы.
//
// Параметры:
//   АдресРезультата - Строка - Адрес результата во временном хранилище.
//
// Возвращаемое значение:
//   Строка - JSON результата фонового задания.
//
// Исключения:
//   Текст ошибки чтения из временного хранилища.
&НаСервере
Функция ПолучитьРезультатНаСервереMCP(АдресРезультата)
	Возврат ПолучитьИзВременногоХранилища(АдресРезультата);
КонецФункции

// Извлекает и валидирует идентификатор операции из аргументов вызова.
//
// Параметры:
//   Запрос - Структура - Запрос вызова инструмента.
//
// Возвращаемое значение:
//   Строка - Идентификатор операции или пустая строка, если параметр некорректен.
&НаКлиенте
Функция ИдентификаторОперацииMCP(Запрос)
	Идентификатор = ЗначениеПараметраЗапроса(Запрос, "operation_id");
	Если ТипЗнч(Идентификатор) <> Тип("Строка") Или ПустаяСтрока(Идентификатор) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		УникальныйИдентификаторОперации = Новый УникальныйИдентификатор(Идентификатор);
	Исключение
		Возврат "";
	КонецПопытки;
	Возврат Строка(УникальныйИдентификаторОперации);
КонецФункции

#КонецОбласти

#Область ОбщиеФункцииИнструментов

&НаКлиенте
Функция ЗначениеПараметраЗапроса(Запрос, ИмяПараметра)
	Значение = Неопределено;
	Если ТипЗнч(Запрос) = Тип("Структура")
		И ТипЗнч(Запрос.Аргументы) = Тип("Структура") Тогда
		Запрос.Аргументы.Свойство(ИмяПараметра, Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Нормализует лимит выборки: 0 или пусто -> 100, максимум 1000.
//
// Параметры:
//   Лимит - Число, Неопределено - Запрошенный лимит строк.
//
// Возвращаемое значение:
//   Число - Нормализованный лимит.
// Сериализует значение в строку JSON (Структура, Массив, Соответствие, примитивы).
//
// Параметры:
//   Значение - Произвольный - Значение для сериализации.
//
// Возвращаемое значение:
//   Строка - JSON-представление значения.
&НаКлиентеНаСервереБезКонтекста
Функция СериализоватьJSONMCP(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НормализованныйЛимитMCP(Лимит)
	Если Лимит = Неопределено Тогда
		Возврат 100;
	КонецЕсли;
	Лимит = Цел(Лимит);
	Если Лимит <= 0 Тогда
		Возврат 100;
	КонецЕсли;
	Возврат Мин(Лимит, 1000);
КонецФункции

// Преобразует значение для установки в параметр запроса:
// ISO-строка ГГГГ-ММ-ДД[Thh:mm:ss] -> Дата, остальные значения как есть.
//
// Параметры:
//   Значение - Произвольный - Значение параметра.
//
// Возвращаемое значение:
//   Произвольный - Значение для УстановитьПараметр.
&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеДляПараметраЗапросаMCP(Значение)
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		ДатаЗначения = ПрочитатьДатуПараметраMCP(Значение);
		Если ДатаЗначения <> Неопределено Тогда
			Возврат ДатаЗначения;
		КонецЕсли;
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Читает дату из строки формата ГГГГ-ММ-ДД или ГГГГ-ММ-ДД[Thh:mm:ss].
//
// Параметры:
//   Значение - Строка - Строка с датой в формате ISO.
//
// Возвращаемое значение:
//   Дата - Прочитанная дата.
//   Неопределено - Строка не является датой ISO.
&НаКлиентеНаСервереБезКонтекста
Функция ПрочитатьДатуПараметраMCP(Значение)
	Строковое = СокрЛП(Значение);
	Длина = СтрДлина(Строковое);
	Если Длина <> 10 И Длина <> 19 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Сред(Строковое, 5, 1) <> "-" Или Сред(Строковое, 8, 1) <> "-" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Длина = 19 Тогда
		Если (Сред(Строковое, 11, 1) <> "T" И Сред(Строковое, 11, 1) <> " ")
			Или Сред(Строковое, 14, 1) <> ":" Или Сред(Строковое, 17, 1) <> ":" Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Для Позиция = 1 По Длина Цикл
		Если Позиция = 5 Или Позиция = 8
			Или (Длина = 19 И (Позиция = 11 Или Позиция = 14 Или Позиция = 17)) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти("0123456789", Сред(Строковое, Позиция, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если Длина = 10 Тогда
		Строковое = Строковое + "T00:00:00";
	Иначе
		Строковое = СтрЗаменить(Строковое, " ", "T");
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип("Дата"), Строковое);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Преобразует значение колонки результата запроса для JSON:
// примитивы передаются как есть, Null/Неопределено -> null, остальное -> строка.
//
// Параметры:
//   Значение - Произвольный - Значение колонки выборки.
//
// Возвращаемое значение:
//   Произвольный - Значение для сериализации в JSON.
&НаКлиентеНаСервереБезКонтекста
Функция ЗначениеРезультатаЗапросаMCP(Значение)
	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число")
		Или ТипЗначения = Тип("Булево") Или ТипЗначения = Тип("Дата") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Строка(Значение);
КонецФункции

// Формирует JSON-описание результата вычисления.
//
// Тип значения передаётся строкой всегда; значение сериализуется в нативный JSON-тип там, где возможно:
// Число -> число, Булево -> true/false, Неопределено -> null, Дата -> строка ISO-8601,
// Строка -> строка; остальные типы - строковое представление.
//
// Параметры:
//   Результат - Произвольный - Результат вычисления выражения.
//
// Возвращаемое значение:
//   Строка - JSON вида {"type": <тип результата>, "value": <значение>}.
&НаКлиенте
Функция СериализоватьРезультатMCP(Результат)

	ТипРезультата = ТипЗнч(Результат);

	Обёртка = Новый Структура;
	Обёртка.Вставить("type", Строка(ТипРезультата));

	Если ТипРезультата = Тип("Число")
		Или ТипРезультата = Тип("Булево")
		Или ТипРезультата = Тип("Строка")
		Или ТипРезультата = Тип("Неопределено") Тогда
		Обёртка.Вставить("value", Результат);
	ИначеЕсли ТипРезультата = Тип("Дата") Тогда
		ЗначениеДаты = "";
		Если Результат > Дата(1, 1, 1) Тогда
			ЗначениеДаты = Формат(Результат, "ДФ=гггг-ММ-дд") + "T" + Формат(Результат, "ДФ=ЧЧ:мм:сс");
		КонецЕсли;
		Обёртка.Вставить("value", ЗначениеДаты);
	Иначе
		Обёртка.Вставить("value", Строка(Результат));
	КонецЕсли;

	Возврат ЗаписатьЗначениеJSON(Обёртка);

КонецФункции

// Извлекает текст самой глубокой причины из информации об ошибке.
//
// Параметры:
//   ИнформацияОбОшибке - ИнформацияОбОшибке - Информация об ошибке.
//
// Возвращаемое значение:
//   Строка - Текст ошибки.
&НаКлиентеНаСервереБезКонтекста
Функция ТекстОшибкиMCP(ИнформацияОбОшибке)
	Текст = ИнформацияОбОшибке.Описание;
	Причина = ИнформацияОбОшибке.Причина;
	Пока Причина <> Неопределено Цикл
		Текст = Причина.Описание;
		Причина = Причина.Причина;
	КонецЦикла;
	Возврат Текст;
КонецФункции

#КонецОбласти

#КонецОбласти
